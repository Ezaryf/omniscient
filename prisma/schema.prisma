generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String     @id @default(cuid())
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String
  scenario    Scenario?
  branches    Branch[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Scenario {
  id          String     @id @default(cuid())
  projectId   String     @unique
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  summary     String
  seed        Int
  rules       RuleSet?
  branches    Branch[]
  snapshots   Snapshot[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Branch {
  id               String             @id @default(cuid())
  projectId        String
  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenarioId       String
  scenario         Scenario           @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  parentBranchId   String?
  parentBranch     Branch?            @relation("BranchTree", fields: [parentBranchId], references: [id], onDelete: SetNull)
  childBranches    Branch[]           @relation("BranchTree")
  name             String
  summary          String
  branchPointTick  Int
  currentTick      Int
  stateHash        String
  status           String
  latestState      Json
  agents           Agent[]
  relationships    Relationship[]
  events           Event[]
  snapshots        Snapshot[]
  narratives       NarrativeSummary[]
  proposals        ProposalLedger[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model Snapshot {
  id          String    @id @default(cuid())
  scenarioId  String
  scenario    Scenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tick        Int
  kind        String
  stateHash   String
  state       Json
  createdAt   DateTime  @default(now())

  @@index([branchId, tick])
}

model Agent {
  id          String    @id
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name        String
  type        String
  factionId   String
  goals       Json
  traits      Json
  state       Json
  resources   Json
  memory      Json
  position    Json
  status      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([branchId])
}

model Relationship {
  id              String   @id
  branchId        String
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sourceAgentId   String
  targetAgentId   String
  trust           Float
  influence       Float
  tension         Float
  lastUpdatedTick Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([branchId])
}

model Event {
  id            String   @id
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tick          Int
  type          String
  sourceAgentId String?
  targetAgentId String?
  description   String
  impact        Json
  causeChain    Json
  metadata      Json
  createdAt     DateTime @default(now())

  @@index([branchId, tick])
}

model RuleSet {
  id                String    @id @default(cuid())
  scenarioId        String    @unique
  scenario          Scenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  scarcity          Float
  trustDecay        Float
  contagion         Float
  shockLikelihood   Float
  maxTicks          Int
  aiConfidenceFloor Float
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model NarrativeSummary {
  id          String   @id @default(cuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tick        Int
  scope       String
  subjectId   String
  title       String
  summary     String
  evidence    Json
  confidence  Float
  generatedBy String
  createdAt   DateTime @default(now())

  @@index([branchId, tick])
}

model ProposalLedger {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tick      Int
  proposals Json
  createdAt DateTime @default(now())

  @@unique([branchId, tick])
}
